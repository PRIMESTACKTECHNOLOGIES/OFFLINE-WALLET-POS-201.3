# Backend environment variables for POS Offline/Online processing
# Replace placeholder values before running in production

# ─── npm registry token (read-only install) ───────────────────────────────────
# Generated as Granular Access Token — Read-only, "Only select packages & scopes"
#   https://www.npmjs.com/settings/YOUR_NPM_USERNAME/tokens/granular-access-tokens/new
# Consumed automatically via the project-level .npmrc file:
#   //registry.npmjs.org/:_authToken=${NPM_TOKEN}
NPM_TOKEN=replace_this_with_your_npm_token_starts_with_npm_

# Card processor (used for online EMV/ISO authorizations)
CARD_PROCESSOR_URL=https://processor.example.com/api/authorize
CARD_PROCESSOR_KEY=sk_test_replace_me

# Alternative env names supported by the code
PAYMENT_PROCESSOR_URL=
PAYMENT_PROCESSOR_KEY=
# Backend base URL (used for callbacks)
BACKEND_URL=http://your.backend.example

# Other settings
POS_OFFLINE_FLOOR_LIMIT_MINOR=25000
